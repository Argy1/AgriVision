# Project AgriVision (org "Kuliah"). Service role key HARUS diambil sendiri dari
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# JANGAN PERNAH commit file .env asli atau expose key ini ke frontend/client.
SUPABASE_URL=https://ymfcrxymizwwolikgrhq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key -- bukan secret, tapi tetap taruh di .env supaya tidak hardcode di
# kode. Hanya dipakai tests/test_e2e_diagnose.py. Ambil dari Supabase Dashboard -> Settings
# -> API -> anon/public key.
SUPABASE_ANON_KEY=

# Nama bucket Storage tempat foto tanaman disimpan.
STORAGE_BUCKET=plant-photos

# Folder berisi tomato_classifier.tflite, chili_classifier.tflite, label_map.json
MODEL_DIR=models

# Origin yang boleh mengakses API ini (pisahkan dengan koma kalau lebih dari satu).
# "*" hanya untuk development lokal — ganti ke origin web/app asli sebelum production.
ALLOWED_ORIGINS=*
