# Variabel untuk `docker compose up` (salin ke .env; .env tidak ikut git).
# Semua nilai berasal dari project Supabase MILIK ANDA:
#   Dashboard -> Project Settings -> API.
# Langkah membuat project + menjalankan SQL: docs/10-panduan-setup-mandiri.md

# URL project, mis. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# anon / publishable key (boleh publik; dipakai web, app, dan tes)
SUPABASE_ANON_KEY=

# service_role key -- RAHASIA. Hanya dipakai ml-service. Jangan commit, jangan tempel ke chat/dokumen.
SUPABASE_SERVICE_ROLE_KEY=

# --- opsional (nilai bawaan sudah cocok untuk lokal) ---
# STORAGE_BUCKET=plant-photos
# ALLOWED_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_ML_API_URL=http://localhost:8000
# REJECT_CONFIDENCE=0.30
# GATE_THRESHOLD=0.45
# GATE_MULTICROP=0
